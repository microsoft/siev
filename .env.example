# SIEV Framework Environment Configuration
# Copy this file to env/.env and configure with your actual API credentials

# =============================================================================
# TWO-TIER API ARCHITECTURE
# =============================================================================

# General Models API - for standard chat models and local endpoints
# Used by: general_api.py
# Model routing: All models except specific reasoning variants
# Examples: "gpt-4o", "gpt-5-chat", "claude-3.5-sonnet", "llama-3.1-70b"
# Endpoint examples:
#   - OpenAI: https://api.openai.com/v1
#   - Azure OpenAI: https://your-resource.openai.azure.com/
#   - Custom/Internal: https://your-custom-endpoint.com/v1
GENERAL_API_KEY=your-general-models-api-key-here
GENERAL_API_ENDPOINT=https://your-general-endpoint.com/v1

# Reasoning Models API - for O1, O3, specific GPT-5 reasoning models
# Used by: reasoning_api.py  
# Model routing: Auto-detected for advanced reasoning models
# Examples: "o1-preview", "o3-mini", "gpt-5-2025-08-07"
# Endpoint examples:
#   - OpenAI: https://api.openai.com/v1
#   - Azure OpenAI: https://your-resource.openai.azure.com/
#   - Custom/Internal: https://your-reasoning-endpoint.com/v1
REASONING_API_KEY=your-reasoning-models-api-key-here
REASONING_API_ENDPOINT=https://your-reasoning-endpoint.com/v1

# =============================================================================
# OPTIONAL CONFIGURATIONS
# =============================================================================

# Alternative environment variable names (for compatibility)
CUSTOM_PROXY_API_KEY=your-custom-proxy-key
CUSTOM_PROXY_ENDPOINT=https://your-proxy.com/v1

# OpenAI Direct API (if using OpenAI directly)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_ENDPOINT=https://api.openai.com/v1

# DeepSeek API (for direct DeepSeek access)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1

# Anthropic API (for direct Claude access)
ANTHROPIC_API_KEY=your-anthropic-api-key

# =============================================================================
# FRAMEWORK SETTINGS  
# =============================================================================

# Additional API configurations (optional)
LOCAL_KEY=your-local-api-key-or-dummy
AZURE_API_KEY=your-azure-key-if-needed
AZURE_ENDPOINT=https://your-resource.openai.azure.com
